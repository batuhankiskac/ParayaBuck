[Unit]
Description=ParayaBuck Paper Trading Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
EnvironmentFile=/opt/parayabuck/.env
# Single-runner guard: this VM is the designated trading host for the shared
# Alpaca PAPER account. Remove this line and the engine refuses to start
# (console and backtests keep working). Every other machine must NOT set it.
Environment=PARAYABUCK_TRADING_HOST=1
ExecStartPre=/opt/parayabuck/.venv/bin/parayabuck doctor --strict --paper --offline
ExecStart=/opt/parayabuck/.venv/bin/parayabuck web
Restart=on-failure
RestartSec=10
# A graceful stop joins the stream, account, decision and journal workers in
# sequence; 120 s covers the worst case so systemd never SIGKILLs mid-persist.
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# State persistence (settings drawer, runtime DB/journal, backtest reports);
# everything else is read-only. The app refuses a non-loopback bind.
ReadWritePaths=/opt/parayabuck/config /opt/parayabuck/data /opt/parayabuck/reports
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# AF_NETLINK: glibc getaddrinfo probes interfaces over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute stays off: CPython/numpy may need W+X mappings.

[Install]
WantedBy=multi-user.target
