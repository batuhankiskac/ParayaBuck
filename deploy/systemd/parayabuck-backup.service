[Unit]
Description=ParayaBuck SQLite Backup (online, verified)
After=network-online.target

[Service]
Type=oneshot
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
# Narrow env file, not .env: the backup and the off-host copy command it starts
# inherit only what it holds (no Alpaca keys, approval key or LIVE switch).
# ENV_PATH makes the config loader read the same file (docs/deployment.md,
# "Backup environment file").
EnvironmentFile=/opt/parayabuck/.env.backup
Environment=ENV_PATH=/opt/parayabuck/.env.backup
# The off-host copy runs under ProtectHome, so gcloud keeps its state in a writable path
# under data/ and never reads the deploy user's own gcloud login (S3-4-4). Create it once,
# owned by the service user. Use GOOGLE_APPLICATION_CREDENTIALS in .env.backup for the key.
Environment=CLOUDSDK_CONFIG=/opt/parayabuck/data/gcloud
ExecStart=/opt/parayabuck/.venv/bin/parayabuck backup
# The off-host copy may take up to 900 s per artifact (backup.OFFHOST_TIMEOUT_SECONDS)
# and runs sequentially. One run copies up to seven artifacts (the snapshot, its
# sidecars and the previous set's sidecars): 7 x 900 s = 6300 s. The start budget
# therefore covers that worst case (R3-3-6). A SIGTERM at the limit now records a
# backup_failed alert (reason terminated) before the process exits.
TimeoutStartSec=6600
# A stop during the off-host copy: the SIGTERM handler records backup_failed (R3-4-7).
# A GCS upload is committed only when it completes.
TimeoutStopSec=120
# A failed run exits non-zero (the unit shows failed in `systemctl status`)
# and records a `backup_failed` alert in the log and the event journal
# (`parayabuck ops events --kind backup_failed`). `parayabuck doctor` reports
# a backup set that is merely stale. The off-host copy runs only when
# PARAYABUCK_BACKUP_OFFHOST_CMD is set in .env.backup.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The backup reads config/ and the decision DB and writes only under data/
# (data/backups plus the event journal in data/runtime).
ReadWritePaths=/opt/parayabuck/data
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
KeyringMode=private
RemoveIPC=true
LimitCORE=0
# AF_NETLINK: glibc getaddrinfo probes interfaces over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
