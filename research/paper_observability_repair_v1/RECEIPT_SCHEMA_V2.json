{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAPER Decision Receipt V2",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "decision_id",
    "decision_timestamp",
    "origin",
    "market",
    "mode",
    "strategy",
    "configuration_digest",
    "universe",
    "account_before",
    "capacity_snapshot",
    "target_state",
    "planned_orders",
    "submission_snapshot",
    "execution_confirmation",
    "database_link"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "receipt_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "scheduled",
        "startup_catch_up"
      ]
    },
    "market": {
      "enum": [
        "equity",
        "crypto"
      ]
    },
    "mode": {
      "const": "paper"
    },
    "strategy": {
      "type": "object",
      "required": [
        "name",
        "version",
        "maximum_allocation"
      ]
    },
    "configuration_digest": {
      "type": "string"
    },
    "universe": {
      "type": "object"
    },
    "account_before": {
      "type": "object"
    },
    "capacity_snapshot": {
      "type": "object"
    },
    "target_state": {
      "type": "object"
    },
    "planned_orders": {
      "type": "array"
    },
    "submission_snapshot": {
      "type": "array"
    },
    "execution_confirmation": {
      "type": "object"
    },
    "database_link": {
      "type": "object"
    },
    "crypto_provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "final_buy_admission": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
