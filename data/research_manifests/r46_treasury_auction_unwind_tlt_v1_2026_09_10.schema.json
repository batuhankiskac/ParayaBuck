{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parayabuck://research/r46-treasury-auction-unwind-tlt-v1-governance-v1",
  "title": "R46 Treasury-auction unwind TLT governance manifest",
  "type": "object",
  "required": [
    "schema_version",
    "research_id",
    "candidate_id",
    "status",
    "declared_before_outcomes",
    "economic_execution",
    "economic_run",
    "economic_outcomes_accessed",
    "outcome_artifacts_present",
    "research_only",
    "promotion",
    "integration_candidate",
    "paper_live_untouched",
    "paper_or_live_activation",
    "auto_promotion",
    "no_auto_promotion",
    "candidate",
    "event_contract",
    "data_contract",
    "execution_contract",
    "source_provenance",
    "holdout",
    "statistics",
    "multiplicity",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "r46-governance-manifest-v1"},
    "candidate_id": {"const": "R46"},
    "status": {"const": "FROZEN_PRE_OUTCOME"},
    "declared_before_outcomes": {"const": true},
    "economic_execution": {"const": false},
    "economic_run": {"const": false},
    "economic_outcomes_accessed": {"const": false},
    "outcome_artifacts_present": {"const": false},
    "research_only": {"const": true},
    "promotion": {"const": false},
    "integration_candidate": {"const": false},
    "paper_live_untouched": {"const": true},
    "paper_or_live_activation": {"const": false},
    "auto_promotion": {"const": false},
    "no_auto_promotion": {"const": true},
    "statistics": {
      "type": "object",
      "required": ["status", "power_justified", "minimums", "power_analysis_path", "power_analysis_sha256", "statistician_approval", "operator_approval"],
      "properties": {
        "status": {"const": "BLOCKED_STATISTICS"},
        "power_justified": {"const": false},
        "minimums": {"type": ["null", "object"]},
        "power_analysis_path": {"type": ["null", "string"]},
        "power_analysis_sha256": {"type": ["null", "string"]},
        "statistician_approval": {"type": ["null", "object"]},
        "operator_approval": {"type": ["null", "object"]}
      }
    },
    "multiplicity": {
      "type": "object",
      "required": ["status", "family_registry_path", "family_registry_sha256", "family_size", "alpha", "statistician_approval", "operator_approval"],
      "properties": {
        "status": {"const": "BLOCKED_STATISTICS"},
        "family_registry_path": {"type": ["null", "string"]},
        "family_registry_sha256": {"type": ["null", "string"]},
        "family_size": {"type": ["null", "integer"]},
        "alpha": {"type": ["null", "number"]},
        "statistician_approval": {"type": ["null", "object"]},
        "operator_approval": {"type": ["null", "object"]}
      }
    },
    "data_contract": {
      "type": "object",
      "required": ["source_matrix_path", "source_matrix_sha256", "pit_source_status"],
      "properties": {
        "source_matrix_path": {"type": "string"},
        "source_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pit_source_status": {"type": "string"}
      }
    },
    "execution_contract": {
      "type": "object",
      "required": ["native_one_ledger_required", "native_ledger_status"],
      "properties": {
        "native_one_ledger_required": {"const": true},
        "native_ledger_status": {"type": "string"}
      }
    },
    "source_provenance": {
      "type": "object",
      "required": ["base_commit", "source_commit", "clean_tree_required", "clean_tree_observed", "source_files", "runner", "verifier", "preflight", "custody_validator", "source_capability_receipt", "environment"],
      "properties": {
        "source_capability_receipt": {
          "type": "object",
          "required": ["path", "sha256", "artifact_sha256", "status", "route_capability_status", "r46_admission_status"],
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"const": "CAPABILITY_OR_PAID_BLOCKED"},
            "route_capability_status": {"const": "PUBLIC_ROUTES_IDENTIFIED"},
            "r46_admission_status": {"const": "DATA_ACQUISITION_REQUIRED"}
          }
        }
      }
    },
    "holdout": {
      "type": "object",
      "required": ["contract_path", "contract_sha256", "mode", "historical_holdout_accepted", "status"]
    },
    "integrity": {
      "type": "object",
      "required": ["schema_path", "schema_sha256", "manifest_sha256"],
      "properties": {
        "schema_path": {"type": "string"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
