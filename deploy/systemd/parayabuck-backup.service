[Unit]
Description=ParayaBuck SQLite Backup (online, verified)
After=network-online.target

[Service]
Type=oneshot
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
EnvironmentFile=/opt/parayabuck/.env
ExecStart=/opt/parayabuck/.venv/bin/parayabuck backup
# A failed run exits non-zero and emits the `backup_failed` alert to the
# webhook in the env file (PARAYABUCK_ALERT_WEBHOOK_URL), so a silent
# multi-week timer outage cannot go unnoticed. parayabuck-watchdog.timer
# additionally reports a backup set that is merely stale.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/parayabuck/config /opt/parayabuck/data /opt/parayabuck/reports /opt/parayabuck/data/backups
