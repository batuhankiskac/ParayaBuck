# Alpaca API credentials (paper trading)
# Get these from https://app.alpaca.markets (paper account → API Keys)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# LIVE uses its OWN key pair (never the paper names above, and paper never
# uses these). Only on the LIVE trading host; never on a laptop.
# ALPACA_LIVE_API_KEY=your_live_api_key_here
# ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here

# Live remains disabled unless all live config, this flag, a dollar cap, and
# a valid short-lived HMAC operator approval agree.
PARAYABUCK_ENABLE_LIVE=NO
PARAYABUCK_OPERATOR_APPROVAL_KEY=replace_with_at_least_32_random_characters

# Single-runner guard. ONLY the designated trading host (the VM systemd unit,
# deploy/systemd/parayabuck.service) sets PARAYABUCK_TRADING_HOST=1; leave it
# unset in every .env, laptop or container. With it absent the console,
# settings and backtests work and every engine start is refused.
# PARAYABUCK_TRADING_HOST=1

# Opt-in e-mail alerts (alerting.email in config/settings.yaml). The SMTP
# login comes from this file or systemd credentials, never from the settings file. For Gmail use a
# 16-character App Password, not the account password.
# PARAYABUCK_SMTP_USERNAME=your_address@gmail.com
# PARAYABUCK_SMTP_PASSWORD=your_app_password_here

# Off-host backup copy (PARAYABUCK_BACKUP_OFFHOST_CMD) and the backup unit's
# SMTP lines: the backup unit reads /opt/parayabuck/.env.backup instead of this
# file (docs/deployment.md, "Backup environment file").
# General
LOG_LEVEL=INFO
CONFIG_PATH=./config/settings.yaml
# Headless deployments: OPEN_BROWSER=0 (no browser thread on the VM)
OPEN_BROWSER=0
