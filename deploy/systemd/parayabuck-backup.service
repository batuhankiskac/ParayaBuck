[Unit]
Description=ParayaBuck SQLite Backup (online, verified)
After=network-online.target

[Service]
Type=oneshot
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
EnvironmentFile=/opt/parayabuck/.env
ExecStart=/opt/parayabuck/.venv/bin/parayabuck backup
# A failed run exits non-zero (the unit shows failed in `systemctl status`)
# and records a `backup_failed` alert in the log and the event journal
# (`parayabuck ops events --kind backup_failed`). `parayabuck doctor` reports
# a backup set that is merely stale. Nothing is delivered off-host.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The backup reads config/ and the decision DB and writes only under data/
# (data/backups plus the event journal in data/runtime).
ReadWritePaths=/opt/parayabuck/data
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# AF_NETLINK: glibc getaddrinfo probes interfaces over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
