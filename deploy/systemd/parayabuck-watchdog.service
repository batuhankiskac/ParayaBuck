[Unit]
Description=ParayaBuck readiness and backup dead-man probe
# The probe only makes sense while the console process is up: a process that
# crashed is systemd's problem (Restart=on-failure), and skipping a stopped
# service keeps `systemctl stop parayabuck` (deploys, rollbacks) from firing
# false alerts.
After=parayabuck.service
ExecCondition=/usr/bin/systemctl is-active --quiet parayabuck.service

[Service]
Type=oneshot
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
EnvironmentFile=/opt/parayabuck/.env
# Alerts go to the webhook configured in the env file (PARAYABUCK_ALERT_WEBHOOK_URL);
# no credential is stored in this repository or in this unit.
ExecStart=/opt/parayabuck/.venv/bin/parayabuck ops watchdog
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/parayabuck/data
