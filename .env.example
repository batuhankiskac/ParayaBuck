# Alpaca API credentials (paper trading)
# Get these from https://app.alpaca.markets (paper account → API Keys)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Live remains disabled unless all live config, this flag, a dollar cap, and
# a valid short-lived HMAC operator approval agree.
PARAYABUCK_ENABLE_LIVE=NO
PARAYABUCK_OPERATOR_APPROVAL_KEY=replace_with_at_least_32_random_characters

# General
LOG_LEVEL=INFO
CONFIG_PATH=./config/settings.yaml
# Headless deployments: OPEN_BROWSER=0 (no browser thread on the VM)
OPEN_BROWSER=0

# Optional operator notifications: a webhook URL that accepts a JSON POST
# (payload carries message/text/content: Slack or Discord incoming webhooks,
# or any generic JSON receiver).
# Empty or unset = log/journal only. Treat the URL as a secret.
PARAYABUCK_ALERT_WEBHOOK_URL=
