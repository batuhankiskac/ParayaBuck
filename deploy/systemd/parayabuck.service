[Unit]
Description=ParayaBuck Trading Engine (PAPER; LIVE only when configured and authorized)
After=network-online.target
Wants=network-online.target
# Five failed starts within 600 s stop the Restart= loop; the unit then stays failed
# until `systemctl reset-failed parayabuck` and a manual start. No OnFailure= unit ships.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
# READY=1 is sent by the web app once it serves, whether or not the engine
# runs. A 30 s pinger sends WATCHDOG=1 while no engine runs, or while the
# engine's account loop has completed a pass within 120 s (600 s grace after
# start). A hung loop is killed after 300 s and Restart=on-failure brings it
# back. NotifyAccess=main accepts notifications from the main process only.
NotifyAccess=main
WatchdogSec=300
User=parayabuck
Group=parayabuck
WorkingDirectory=/opt/parayabuck
EnvironmentFile=/opt/parayabuck/.env
# Single-runner guard: the trading-host designation (PARAYABUCK_TRADING_HOST=1)
# is NOT in this template. Without it the engine refuses to start and the console
# and backtests keep working. Only the designated host adds it, as a drop-in
# (deploy/systemd/vm-dropin/trading-host.conf; docs/deployment.md, "Trading host").
# Mode-aware preflight: validates the configured runtime.mode. PAPER gets
# exactly the --paper invariant set (no live flag, no cap, paper keys); LIVE
# gets the LIVE gate set (live keys, cap, approval key, e-mail alerts). LIVE
# still starts only through the engine's own guards (re-arm or a valid
# standing LIVE authorization).
ExecStartPre=/opt/parayabuck/.venv/bin/parayabuck doctor --strict --configured-mode --offline
ExecStart=/opt/parayabuck/.venv/bin/parayabuck web
Restart=on-failure
RestartSec=10
# A graceful stop joins the stream, account, decision and journal workers in
# sequence after a 30 s HTTP drain and a 30 s wait on an in-flight start;
# 180 s covers that worst case so systemd never SIGKILLs mid-persist.
TimeoutStopSec=180
# The start budget covers ExecStartPre, which runs the full SQLite integrity_check
# on every start (R2-4-3). The default 90 s would fail a start on a grown ledger,
# and with Type=notify the start completes only at READY=1. The engine warm-up runs
# after READY and is not counted here. Install the same value on the VM with
# deploy/systemd/vm-dropin/start-timeout-engine.conf.
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# State persistence (settings drawer, runtime DB/journal, backtest reports);
# everything else is read-only. The app refuses a non-loopback bind.
# reports/ may be missing on a fresh host (the First install step creates it); the
# '-' prefix keeps the namespace setup from failing before ExecStartPre runs.
ReadWritePaths=/opt/parayabuck/config /opt/parayabuck/data -/opt/parayabuck/reports
# The engine only reads the backups; parayabuck-backup.service writes them. The
# read-only mount stops the trading process from rewriting or deleting its own
# restore points (S2-10-5). The doctor's "backup path writable" row is a WARN
# under this mount, not a blocker, so ExecStartPre still passes.
ReadOnlyPaths=-/opt/parayabuck/data/backups
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
KeyringMode=private
RemoveIPC=true
LimitCORE=0
# AF_NETLINK: glibc getaddrinfo probes interfaces over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute stays off until the VM trial run has passed (VM trial
# item, docs/deployment.md "Sandbox"). Not enabled here on purpose.
# Egress is not contained by this unit (accepted risk, docs/deployment.md
# "Accepted risks"): the LIVE keys and the approval key sit in this process.

[Install]
WantedBy=multi-user.target
